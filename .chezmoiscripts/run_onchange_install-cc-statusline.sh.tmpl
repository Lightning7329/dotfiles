#!/bin/sh
set -eu

# cc-statusline: https://github.com/Lightning7329/cc-statusline
# install.sh がプラットフォームに応じたバイナリを取得し、
# ~/.claude/settings.json の statusLine キーも自前で書き換える
# (このキーはあえて chezmoi 側では管理しない。dot_claude/modify_private_settings.json 参照)。
#
# 下のコメントに最新リリースのタグ名を埋め込んでいるので、上流に新しいリリースが
# 出るたびにこのスクリプトのレンダリング結果が変わり、run_onchange_ の仕組みで
# chezmoi が自動的に再インストールを実行してくれる。
# latest release: {{ (gitHubLatestRelease "Lightning7329/cc-statusline").TagName | toString }}
curl -fsSL https://raw.githubusercontent.com/Lightning7329/cc-statusline/main/install.sh | sh
