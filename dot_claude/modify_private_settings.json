#!/bin/sh
# stdin  = 現在の ~/.claude/settings.json
# stdout = 新しい ~/.claude/settings.json
#
# 管理方針と、jq の `*` がキーを削除できないので hooks だけ代入にしている件は
# CLAUDE.md 参照。managed が hooks しか持たない今はマージ側が空回りしているが、
# 削除を効かせたいキーが他に増えたときのために構造は残してある。
current="$(cat)"
managed='{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/bin/bell.sh Finished"
          }
        ]
      }
    ]
  }
}'

# Notification にフックを付けていないのは意図的。許可プロンプトは Claude Code
# 自身が OSC 通知を出すので、足すと二重に鳴る。Stop を埋める理由は bell.sh 参照。

if [ -z "$current" ]; then
  echo "$managed"
else
  echo "$current" | jq --argjson managed "$managed" '. * $managed | .hooks = ($managed.hooks // {})'
fi
