    "toggleboolean.mapping": {
        "true": false,
        "false": true,
        "True": "False",
        "False": "True",
        "yes": "no",
        "no": "yes",
        "on": "off",
        "off": "on",
        "enabled": "disabled",
        "disabled": "enabled",
    },
    "sonarlint.rules": {
