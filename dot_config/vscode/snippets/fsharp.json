
{
	// Place your snippets for fsharp here. Each snippet is defined under a snippet name and has a prefix, body and
	// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the
	// same ids are connected.
	// Example:
	// "Print to console": {
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }
	"input 1 int": {
		"prefix": "input1",
		"body": [
			"let ${1:a} = stdin.ReadLine() |> int"
		]
	},
	"input 2 int": {
		"prefix": "input2",
		"body": [
			"let ${1:a}, ${2:b} = stdin.ReadLine().Split() |> Array.map int |> fun a -> a[0], a[1]"
		]
	},
	"input int array": {
		"prefix": "input array",
		"body": [
			"let ${1:a} = stdin.ReadLine().Split() |> Array.map int"
		]
	},
}
